        "dark": "{blue.350}"
      },
      "authenticationTint": {
        "light": "{blue.50}",
        "dark": "{dark.surface2}"
      },
      "processing": {
        "light": "{teal.600}",
        "dark": "{teal.300}"
      },
      "processingTint": {
        "light": "{teal.50}",
        "dark": "{dark.infoTint}"
      },
      "pending": {
        "light": "{teal.600}",
        "dark": "{teal.300}"
      },
      "pendingTint": {
        "light": "{teal.50}",
        "dark": "{dark.infoTint}"
      },
      "completed": {
        "light": "{green.600}",
        "dark": "{green.300}"
      },
      "completedTint": {
        "light": "{green.50}",
        "dark": "{dark.posTint}"
      },
      "failed": {
        "light": "{red.600}",
        "dark": "{red.300}"
      },
      "failedTint": {
        "light": "{red.50}",
        "dark": "{dark.negTint}"
      },
      "unknown": {
        "light": "{teal.600}",
        "dark": "{teal.300}"
      },
      "unknownTint": {
        "light": "{teal.50}",
        "dark": "{dark.infoTint}"
      },
      "blocked": {
        "light": "{amber.600}",
        "dark": "{amber.300}"
      },
      "blockedTint": {
        "light": "{amber.50}",
        "dark": "{dark.warnTint}"
      },
      "reversed": {
        "light": "{purple.600}",
        "dark": "{purple.300}"
      },
      "reversedTint": {
        "light": "{purple.50}",
        "dark": "{dark.holdTint}"
