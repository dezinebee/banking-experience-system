        "light": "0 1px 2px rgba(22,28,46,.08)",
        "dark": "none"
      },
      "e2": {
        "light": "0 2px 8px rgba(22,28,46,.10)",
        "dark": "none"
      },
      "e3": {
        "light": "0 8px 24px rgba(22,28,46,.14)",
        "dark": "none"
