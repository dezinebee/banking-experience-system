      "instant": "80ms",
      "fast": "140ms",
      "standard": "220ms",
      "gentle": "320ms",
      "deliberate": "480ms",
      "easeStandard": "cubic-bezier(0.2,0,0,1)",
      "easeEnter": "cubic-bezier(0,0,0,1)",
      "easeExit": "cubic-bezier(0.3,0,1,1)",
      "spin": "700ms",
      "pulse": "1400ms"
    },
    "z": {
      "base": "0",
      "raised": "10",
      "sticky": "100",
      "drawer": "800",
      "modal": "900",
      "toast": "950",
      "critical": "1000"
    }
  },
  "semantic": {
    "surface": {
      "primary": {
        "light": "{gray.0}",
        "dark": "{dark.surface1}"
      },
      "secondary": {
        "light": "{gray.50}",
        "dark": "{dark.surface2}"
      },
      "tertiary": {
        "light": "{gray.100}",
        "dark": "{dark.surface3}"
      },
      "raised": {
        "light": "{gray.0}",
        "dark": "{dark.raised}"
      },
      "inverse": {
        "light": "{gray.900}",
        "dark": "{dark.raised}"
      }
    },
    "text": {
      "primary": {
        "light": "{gray.900}",
        "dark": "{dark.text1}"
      },
      "secondary": {
        "light": "{gray.600}",
        "dark": "{dark.text2}"
      },
      "disabled": {
        "light": "{gray.400}",
        "dark": "{dark.text3}"
      },
      "inverse": {
        "light": "{gray.0}",
        "dark": "{gray.900}"
      },
      "link": {
        "light": "{blue.600}",
        "dark": "{blue.350}"
      },
      "onAction": {
        "light": "{gray.0}",
        "dark": "{blue.900}"
      }
    },
    "border": {
      "default": {
        "light": "{gray.200}",
        "dark": "{dark.line}"
