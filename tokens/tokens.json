        "light": "{red.600}",
        "dark": "{red.300}"
      },
      "input": {
        "light": "{gray.500}",
        "dark": "#8A94A8",
        "$note": "Functional control boundaries (inputs, PIN cells, upload zones) - held to WCAG 1.4.11 3:1. border.default/strong remain decorative separators."
      }
    },
    "action": {
      "primary": {
        "light": "{blue.600}",
        "dark": "{blue.350}"
      },
      "primaryHover": {
        "light": "{blue.700}",
        "dark": "{blue.300}"
      },
      "primaryPressed": {
        "light": "{blue.800}",
        "dark": "{blue.200}"
      },
      "destructive": {
        "light": "{red.600}",
        "dark": "{red.300}"
      }
    },
    "status": {
      "$note": "Generic UI status for non-transaction surfaces: form validation, alerts, banners. A transaction's state comes from transaction.*.",
      "success": {
        "light": "{green.600}",
        "dark": "{green.300}"
      },
      "successTint": {
        "light": "{green.50}",
        "dark": "{dark.posTint}"
      },
      "warning": {
        "light": "{amber.600}",
        "dark": "{amber.300}"
      },
      "warningTint": {
        "light": "{amber.50}",
        "dark": "{dark.warnTint}"
      },
      "error": {
        "light": "{red.600}",
        "dark": "{red.300}"
      },
      "errorTint": {
        "light": "{red.50}",
        "dark": "{dark.negTint}"
      },
      "info": {
        "light": "{teal.600}",
        "dark": "{teal.300}"
      },
      "infoTint": {
        "light": "{teal.50}",
        "dark": "{dark.infoTint}"
      },
      "neutral": {
        "light": "{gray.600}",
        "dark": "{dark.text2}"
      }
    },
    "financial": {
      "$note": "Value semantics — what an amount MEANS, not what stage it is at. Transaction lifecycle states live in transaction.* and nowhere else.",
      "income": {
        "light": "{green.600}",
        "dark": "{green.300}"
      },
      "expense": {
        "light": "{gray.900}",
        "dark": "{dark.text1}",
        "$note": "Expense is neutral by design - red is reserved for problems"
